{
  "name": "agent-trajectory",
  "version": "0.1.0",
  "description": "Terminal monitor for AI coding agents — watch tool calls, model responses, tokens and context across Claude Code, Codex, DeepSeek Harness and Hermes in one live feed.",
  "keywords": [
    "claude-code",
    "codex",
    "deepseek",
    "agent",
    "tui",
    "monitor",
    "trajectory",
    "tokens",
    "observability"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "bin": {
    "atrajectory": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "dev": "node --experimental-strip-types src/cli.tsx",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ink": "^5.2.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "typescript": "^5.7.2"
  }
}
